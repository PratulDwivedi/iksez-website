# Supabase project backing the /admin console and /api routes. This is a
# shared multi-tenant project — IFFCO Kisan SEZ is tenant_id=3 ("iffcosez")
# in its public.tenants table. Tenant scoping is server-side (RLS + the
# logged-in admin's profiles.tenant_id), not env-driven.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL for the `blog-covers` Supabase Storage bucket, used to
# resolve a stored bare cover_url filename into a full URL — see
# lib/blogCover.ts.
NEXT_PUBLIC_BLOG_COVER_BASE_URL=

# First-party Publishable API Key for IFFCO Kisan SEZ's own tenant — lets
# the public /blog page call fn_get_website_blogs/fn_get_website_blog_tags
# as this tenant instead of requiring a third party's key. Generate/reset
# from /admin/settings ("Publishable API Key" card) — reveal-once, so copy
# it immediately into .env.local.
NEXT_PUBLIC_IKSEZ_PUBLISHABLE_KEY=
