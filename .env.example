# Supabase project backing the /admin console and /api routes. This is a
# shared multi-tenant project — IFFCO Kisan SEZ is tenant_id=3 ("iffcosez")
# in its public.tenants table. Tenant scoping is server-side (RLS + the
# logged-in admin's profiles.tenant_id), not env-driven.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL for the `blog-covers` Supabase Storage bucket, used to
# resolve a stored bare cover_url filename into a full URL — see
# lib/blogCover.ts.
NEXT_PUBLIC_BLOG_COVER_BASE_URL=
